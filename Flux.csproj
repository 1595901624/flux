<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Flux</RootNamespace>
    <AssemblyName>Flux</AssemblyName>
    <!-- 版本单一来源：发布时由 build-msix workflow 输入统一写入 appxmanifest；
         此处为便携版程序集版本，需与 Package.appxmanifest 的 Identity Version 保持一致 -->
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- i18n：默认（回退）语言为英文；各语言 resw 经 MRT Core 打包进 resources.pri -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Flux.Core\Flux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
    <!-- Flux.Core / Flux.Service / Flux.Service.Installer 是独立项目，禁止被默认 glob 重复编译 -->
    <Compile Remove="Flux.Core\**\*.cs" />
    <None Remove="Flux.Core\**\*" />
    <Compile Remove="Flux.Service\**\*.cs" />
    <None Remove="Flux.Service\**\*" />
    <Compile Remove="Flux.Service.Installer\**\*.cs" />
    <None Remove="Flux.Service.Installer\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 每个运行时包只携带与其 CPU 架构匹配的 mihomo 内核。 -->
    <Content Include="Assets\core\win-x86\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-x86'" />
    <Content Include="Assets\core\win-x64\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <Content Include="Assets\core\win-arm64\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    <!-- AppWindow.SetIcon / 托盘图标运行时从输出目录读取 app.ico -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 修复：dotnet publish 不会复制应用自身的 Flux.pri，未打包 WinUI
       启动时因缺少该文件而立即崩溃（combase 80004005） -->
  <Target Name="EnsurePriInPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

  <!-- 仅在 CI / 命令行传入 WindowsPackageType=MSIX 打包时使用 -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\SplashScreen.png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

</Project>

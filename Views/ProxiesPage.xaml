<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flux.ViewModels"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="Proxies_Title" Text="代理" FontSize="26" FontWeight="SemiBold" />
                <ctk:Segmented
                    x:Name="ModeSegment"
                    VerticalAlignment="Center">
                    <ctk:SegmentedItem Tag="rule" Content="规则" />
                    <ctk:SegmentedItem Tag="global" Content="全局" />
                    <ctk:SegmentedItem Tag="direct" Content="直连" />
                </ctk:Segmented>
            </StackPanel>
            <TextBox x:Uid="Proxies_FilterBox"
                x:Name="FilterBox"
                Grid.Column="2"
                Width="220"
                PlaceholderText="筛选节点名称/类型"
                VerticalAlignment="Center"
                TextChanged="FilterBox_TextChanged" />
            <Button Grid.Column="3" VerticalAlignment="Center" Click="Providers_Click" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                    <TextBlock Text="Provider" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 空状态 -->
        <StackPanel Grid.Row="1" x:Name="EmptyPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" Margin="0,40,0,0">
            <FontIcon Glyph="&#xE8CB;" FontSize="36" Opacity="0.4" />
            <TextBlock x:Uid="Proxies_Empty" Text="暂无代理组" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Proxies_EmptyHint" Text="请先在「订阅」页导入订阅配置" Opacity="0.5" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 代理组（多列节点卡片） -->
        <GridView
            x:Name="GroupList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="GroupList_ItemClick">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="252" ItemHeight="76" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ProxiesGroupHeader">
                            <Grid Margin="0,8,0,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Type}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind NowDisplay}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind NodeCountText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button
                                        Command="{x:Bind TestDelayCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="整组测速"
                                        Padding="6">
                                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxiesNodeVm">
                    <Border
                        Padding="12,8,10,8"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 选中指示条 -->
                            <Border
                                Width="3"
                                CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}"
                                VerticalAlignment="Stretch"
                                Margin="-12,-8,10,-8" />
                            <Grid Grid.Column="1" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" MaxLines="1" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <ProgressRing Width="14" Height="14" IsActive="True"
                                                      Visibility="{x:Bind TestingVisibility, Mode=OneWay}" />
                                        <Border Background="{x:Bind DelayBrush, Mode=OneWay}" CornerRadius="9" Padding="7,1"
                                                Visibility="{x:Bind HasDelayVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind DelayText, Mode=OneWay}" FontSize="10" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind TypeDisplay, Mode=OneWay}" FontSize="10" Opacity="0.45"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

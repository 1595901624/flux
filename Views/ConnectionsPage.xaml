<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flux.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="连接" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Vm.TotalsText, Mode=OneWay}" Grid.Column="1" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="3"
                Width="220"
                PlaceholderText="搜索主机 / 规则 / 进程"
                VerticalAlignment="Center"
                TextChanged="SearchBox_TextChanged" />
            <ToggleButton
                x:Name="ClosedToggle"
                Grid.Column="4"
                Content="已关闭"
                VerticalAlignment="Center"
                Checked="ClosedToggle_Changed" Unchecked="ClosedToggle_Changed" />
            <Button
                Grid.Column="5"
                VerticalAlignment="Center"
                Click="CloseAll_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="关闭全部" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 表头 -->
        <Grid Grid.Row="1" Padding="12,6,12,6" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="主机" FontSize="12" Opacity="0.6" />
            <TextBlock Text="网络" Grid.Column="1" FontSize="12" Opacity="0.6" />
            <TextBlock Text="下载" Grid.Column="2" FontSize="12" Opacity="0.6" />
            <TextBlock Text="上传" Grid.Column="3" FontSize="12" Opacity="0.6" />
            <TextBlock Text="规则" Grid.Column="4" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="链路" Grid.Column="5" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="进程" Grid.Column="6" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="时间" Grid.Column="7" FontSize="12" Opacity="0.6" />
        </Grid>

        <!-- 连接列表 -->
        <ListView
            x:Name="ConnList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ConnList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionVm">
                    <Grid Padding="12,6,12,6" ColumnSpacing="10" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Host}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Network}" Grid.Column="1" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind DownloadText, Mode=OneWay}" Grid.Column="2" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind UploadText, Mode=OneWay}" Grid.Column="3" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Rule}" Grid.Column="4" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Chains}" Grid.Column="5" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Process}" Grid.Column="6" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind StartText}" Grid.Column="7" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

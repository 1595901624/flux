<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flux.ViewModels"
    xmlns:views="using:Flux.Views"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <views:WrappingPanel Grid.Row="0" Spacing="10">
            <TextBlock x:Uid="Connections_Title" Text="连接" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Vm.TotalsText, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            <ComboBox x:Name="SortBox" MinWidth="140" VerticalAlignment="Center"
                      SelectionChanged="SortBox_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem x:Uid="Connections_SortDefault" Tag="default" Content="默认排序" />
                <ComboBoxItem x:Uid="Connections_SortUpload" Tag="upload" Content="按上传" />
                <ComboBoxItem x:Uid="Connections_SortDownload" Tag="download" Content="按下载" />
            </ComboBox>
            <TextBox FlowDirection="LeftToRight" x:Uid="Connections_SearchBox"
                x:Name="SearchBox"
                Width="220"
                PlaceholderText="搜索主机 / 规则 / 进程"
                VerticalAlignment="Center"
                TextChanged="SearchBox_TextChanged" />
            <Button x:Name="LayoutButton" VerticalAlignment="Center"
                    Click="LayoutToggle_Click" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock x:Uid="Msg_LayoutTable" Text="表格" />
                </StackPanel>
            </Button>
            <Button VerticalAlignment="Center" Click="ColumnSettings_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                    <TextBlock x:Uid="Msg_ColumnSettings" Text="列设置" />
                </StackPanel>
            </Button>
            <ToggleButton x:Uid="Connections_ClosedToggle"
                x:Name="ClosedToggle"
                Content="已关闭"
                VerticalAlignment="Center"
                Checked="ClosedToggle_Changed" Unchecked="ClosedToggle_Changed" />
            <Button
                VerticalAlignment="Center"
                Click="CloseAll_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Uid="Connections_CloseAll" Text="关闭全部" />
                </StackPanel>
            </Button>
        </views:WrappingPanel>

        <!-- 表头（列由代码根据用户配置动态生成） -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" Padding="12,6,12,6" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" ColumnSpacing="10" />

        <!-- 连接列表 -->
        <ListView
            x:Name="ConnList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ConnList_ItemClick">
        </ListView>
    </Grid>
</Page>

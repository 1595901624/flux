<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flux.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 导入 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="订阅" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox
                x:Name="UrlBox"
                Grid.Column="1"
                PlaceholderText="输入订阅链接（https://...），支持 clash:// 安装链接"
                VerticalAlignment="Center"
                KeyDown="UrlBox_KeyDown" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="Import_Click">
                导入
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Center" Click="ImportLocal_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock Text="本地文件" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 状态行 -->
        <Grid Grid.Row="1" Visibility="{x:Bind Vm.StatusVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind Vm.Busy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- 空状态 -->
        <StackPanel Grid.Row="2" x:Name="EmptyPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" Margin="0,60,0,0">
            <FontIcon Glyph="&#xE8F1;" FontSize="36" Opacity="0.4" />
            <TextBlock Text="暂无订阅" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="粘贴订阅链接后点击「导入」，或选择本地 YAML 配置文件" Opacity="0.5" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 订阅卡片 -->
        <GridView
            x:Name="CardList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="CardList_ItemClick">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="360" ItemHeight="172" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemVm">
                    <Border
                        Padding="14"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="选择此订阅" Click="MenuSelect_Click" />
                                <MenuFlyoutItem Text="更新" Click="MenuUpdate_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="上移" Click="MenuUp_Click" />
                                <MenuFlyoutItem Text="下移" Click="MenuDown_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="删除" Click="MenuDelete_Click" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 名称 + 当前徽标 + 操作 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4"
                                            Padding="6,2" VerticalAlignment="Center"
                                            Visibility="{x:Bind CurrentVisibility}">
                                        <TextBlock Text="当前" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Click="MenuUpdate_Click" Style="{StaticResource SubtleButtonStyle}" Padding="5"
                                            ToolTipService.ToolTip="更新订阅">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    </Button>
                                    <Button Click="MenuDelete_Click" Style="{StaticResource SubtleButtonStyle}" Padding="5"
                                            ToolTipService.ToolTip="删除订阅">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="IndianRed" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind Host}" /><Run Text=" · " /><Run Text="{x:Bind TypeText}" />
                            </TextBlock>

                            <TextBlock Grid.Row="2" FontSize="11" Opacity="0.55" Text="{x:Bind UpdatedText}" />

                            <!-- 用量 -->
                            <StackPanel Grid.Row="3" Spacing="4" Visibility="{x:Bind UsageVisibility}" VerticalAlignment="Center">
                                <ProgressBar Value="{x:Bind UsageRatio}" Maximum="1" />
                                <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind UsageText}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" FontSize="11" Opacity="0.55" Text="{x:Bind ExpireText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

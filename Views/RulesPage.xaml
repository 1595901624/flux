<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Flux.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="规则" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Vm.CountText, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="260" VerticalAlignment="Center"
                     PlaceholderText="搜索规则内容" TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="3" VerticalAlignment="Center" Click="Refresh_Click" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="EmptyPanel" Visibility="Collapsed" Spacing="6" HorizontalAlignment="Center" Margin="0,40,0,0">
            <FontIcon Glyph="&#xE71E;" FontSize="32" Opacity="0.35" />
            <TextBlock Text="暂无规则" Opacity="0.55" HorizontalAlignment="Center" />
        </StackPanel>

        <ListView
            x:Name="RuleList"
            Grid.Row="1"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleItemVm">
                    <Grid Padding="12,3,12,3" ColumnSpacing="10" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind IndexText}" FontSize="11" Opacity="0.45" VerticalAlignment="Center" FontFamily="Consolas" />
                        <TextBlock Text="{x:Bind TypeText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" FontFamily="Consolas" />
                        <TextBlock Text="{x:Bind Payload}" Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                        <Border Grid.Column="3" Background="{x:Bind ProxyBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Proxy}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,16,28,20"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <TextBlock Text="系统设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="开机自启动" Description="登录 Windows 时自动启动 Flux">
                    <ToggleSwitch x:Name="AutoLaunchSwitch" Toggled="AutoLaunch_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="静默启动" Description="启动时不显示主窗口">
                    <ToggleSwitch x:Name="SilentStartSwitch" Toggled="SilentStart_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="系统代理" Description="将 Flux 设为系统 HTTP/HTTPS 代理">
                    <ToggleSwitch x:Name="SysProxySwitch" Toggled="SysProxy_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="PAC 模式" Description="系统代理经由自动配置脚本（绕过规则生效）">
                    <ToggleSwitch x:Name="PacSwitch" Toggled="Pac_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="代理守护" Description="定期检查并恢复被其他程序修改的系统代理">
                    <ToggleSwitch x:Name="ProxyGuardSwitch" Toggled="ProxyGuard_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="代理绕过列表" Description="不经过代理的地址（分号分隔）">
                    <TextBox x:Name="BypassBox" MinWidth="260" MaxWidth="520" HorizontalAlignment="Right"
                             LostFocus="Bypass_LostFocus" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock Text="Clash 设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="混合代理端口" Description="HTTP/SOCKS5 混合监听端口（1024-65535）">
                    <NumberBox x:Name="MixedPortBox" Width="140" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden"
                               ValueChanged="MixedPort_Changed" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="允许局域网连接" Description="允许局域网内其他设备使用本机代理">
                    <ToggleSwitch x:Name="AllowLanSwitch" Toggled="AllowLan_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="IPv6" Description="启用 IPv6 支持">
                    <ToggleSwitch x:Name="Ipv6Switch" Toggled="Ipv6_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="日志级别">
                    <ComboBox x:Name="LogLevelBox" Width="140" SelectionChanged="LogLevel_Changed">
                        <ComboBoxItem Content="debug" Tag="debug" />
                        <ComboBoxItem Content="info" Tag="info" />
                        <ComboBoxItem Content="warning" Tag="warning" />
                        <ComboBoxItem Content="error" Tag="error" />
                        <ComboBoxItem Content="silent" Tag="silent" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard Header="应用日志" Description="将运行日志写入日志目录（默认关闭）">
                    <ToggleSwitch x:Name="EnableLogSwitch" Toggled="EnableLog_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="TUN 模式" Description="接管全部系统流量（需要管理员权限）">
                    <ToggleSwitch x:Name="TunSwitch" Toggled="Tun_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="TUN 高级设置" Description="堆栈 / DNS 劫持；应用后重载配置">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="TunStackBox" Width="110" SelectedIndex="0">
                            <ComboBoxItem Tag="gvisor" Content="gvisor" />
                            <ComboBoxItem Tag="system" Content="system" />
                            <ComboBoxItem Tag="mixed" Content="mixed" />
                        </ComboBox>
                        <TextBox x:Name="TunDnsHijackBox" Width="110" PlaceholderText="any:53" />
                        <Button Content="应用" Click="ApplyTunAdvanced_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="DNS 设置" Description="enhanced-mode / fake-ip 范围；应用后重载配置">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="DnsModeBox" Width="120" SelectedIndex="0">
                            <ComboBoxItem Tag="fake-ip" Content="fake-ip" />
                            <ComboBoxItem Tag="redir-host" Content="redir-host" />
                        </ComboBox>
                        <TextBox x:Name="DnsFakeIpRangeBox" Width="140" PlaceholderText="198.18.0.1/16" />
                        <Button Content="应用" Click="ApplyDns_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="外部控制器" Description="RESTful API 地址与 Secret；应用后重启内核">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ControllerBox" Width="160" PlaceholderText="127.0.0.1:9097" />
                        <PasswordBox x:Name="ControllerSecretBox" Width="140" PlaceholderText="Secret" />
                        <Button Content="应用" Click="ApplyController_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="断开连接于模式切换" Description="切换代理模式时关闭全部现有连接">
                    <ToggleSwitch x:Name="AutoCloseConnSwitch" Toggled="AutoCloseConn_Toggled" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock Text="应用" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="主题模式">
                    <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="跟随系统" Tag="system" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard Header="重启内核" Description="重新加载运行时配置并重启 mihomo">
                    <Button Content="重启" Click="RestartCore_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="Flux 服务" Description="以 LocalSystem 运行，普通用户无需管理员即可使用 TUN">
                    <Button Content="安装 / 修复服务" Click="InstallService_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="全局热键 · 显示 / 隐藏窗口" Description="如 Ctrl+Shift+F1；留空禁用">
                    <TextBox x:Name="HotkeyWindowBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="全局热键 · 切换系统代理">
                    <TextBox x:Name="HotkeySysproxyBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="全局热键 · 切换 TUN">
                    <TextBox x:Name="HotkeyTunBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="全局热键 · 重新激活订阅">
                    <TextBox x:Name="HotkeyReactivateBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="全局热键" Description="保存时注册；冲突的组合会被拒绝并显示原因">
                    <Button Content="保存热键" Click="SaveHotkeys_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="复制环境变量" Description="在终端中让命令行程序走代理">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="PowerShell" Click="CopyEnvPowerShell_Click" />
                        <Button Content="CMD" Click="CopyEnvCmd_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="备份与恢复" Description="ZIP 备份应用配置、订阅与增强文件（不含日志与凭据明文）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="创建备份" Click="CreateBackup_Click" />
                        <Button Content="恢复备份" Click="RestoreBackup_Click" />
                        <Button Content="备份目录" Click="OpenBackupDir_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="打开目录" Description="数据目录 / 日志目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="数据目录" Click="OpenData_Click" />
                        <Button Content="日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="GitHub" Description="查看 Flux 的源代码和最新动态">
                    <Button Content="打开 GitHub" Click="OpenGitHub_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="关于 Flux" Description="{x:Bind AppVersion, Mode=OneTime}">
                    <Button Content="退出应用" Click="ExitApp_Click" />
                </sc:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

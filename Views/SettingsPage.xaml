<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,16,28,20"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <TextBlock x:Uid="Settings_Title" Text="设置" FontSize="26" FontWeight="SemiBold" />

            <TextBlock x:Uid="Settings_SectionSystem" Text="系统设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard x:Uid="Settings_CardAutoLaunch" Header="开机自启动" Description="登录 Windows 时自动启动 Flux">
                    <ToggleSwitch x:Name="AutoLaunchSwitch" Toggled="AutoLaunch_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardSilentStart" Header="静默启动" Description="启动时不显示主窗口">
                    <ToggleSwitch x:Name="SilentStartSwitch" Toggled="SilentStart_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardSysProxy" Header="系统代理" Description="将 Flux 设为系统 HTTP/HTTPS 代理">
                    <ToggleSwitch x:Name="SysProxySwitch" Toggled="SysProxy_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardPac" Header="PAC 模式" Description="系统代理经由自动配置脚本（绕过规则生效）">
                    <ToggleSwitch x:Name="PacSwitch" Toggled="Pac_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardProxyGuard" Header="代理守护" Description="定期检查并恢复被其他程序修改的系统代理">
                    <ToggleSwitch x:Name="ProxyGuardSwitch" Toggled="ProxyGuard_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardBypass" Header="代理绕过列表" Description="不经过代理的地址（分号分隔）">
                    <TextBox x:Name="BypassBox" MinWidth="260" MaxWidth="520" HorizontalAlignment="Right"
                             LostFocus="Bypass_LostFocus" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock x:Uid="Settings_SectionClash" Text="Clash 设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard x:Uid="Settings_CardMixedPort" Header="混合代理端口" Description="HTTP/SOCKS5 混合监听端口（1024-65535）">
                    <NumberBox x:Name="MixedPortBox" Width="140" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden"
                               ValueChanged="MixedPort_Changed" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardAllowLan" Header="允许局域网连接" Description="允许局域网内其他设备使用本机代理">
                    <ToggleSwitch x:Name="AllowLanSwitch" Toggled="AllowLan_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardIpv6" Header="IPv6" Description="启用 IPv6 支持">
                    <ToggleSwitch x:Name="Ipv6Switch" Toggled="Ipv6_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardLogLevel" Header="日志级别">
                    <ComboBox x:Name="LogLevelBox" Width="140" SelectionChanged="LogLevel_Changed">
                        <ComboBoxItem Content="debug" Tag="debug" />
                        <ComboBoxItem Content="info" Tag="info" />
                        <ComboBoxItem Content="warning" Tag="warning" />
                        <ComboBoxItem Content="error" Tag="error" />
                        <ComboBoxItem Content="silent" Tag="silent" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardFileLog" Header="应用日志" Description="将运行日志写入日志目录（默认关闭）">
                    <ToggleSwitch x:Name="EnableLogSwitch" Toggled="EnableLog_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardTun" Header="TUN 模式" Description="接管全部系统流量（需要管理员权限）">
                    <ToggleSwitch x:Name="TunSwitch" Toggled="Tun_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardTunAdvanced" Header="TUN 高级设置" Description="堆栈 / DNS 劫持；应用后重载配置">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="TunStackBox" Width="110" SelectedIndex="0">
                            <ComboBoxItem Tag="gvisor" Content="gvisor" />
                            <ComboBoxItem Tag="system" Content="system" />
                            <ComboBoxItem Tag="mixed" Content="mixed" />
                        </ComboBox>
                        <TextBox x:Name="TunDnsHijackBox" Width="110" PlaceholderText="any:53" />
                        <Button x:Uid="Common_Apply" Content="应用" Click="ApplyTunAdvanced_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardDns" Header="DNS 设置" Description="enhanced-mode / fake-ip 范围；应用后重载配置">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="DnsModeBox" Width="120" SelectedIndex="0">
                            <ComboBoxItem Tag="fake-ip" Content="fake-ip" />
                            <ComboBoxItem Tag="redir-host" Content="redir-host" />
                        </ComboBox>
                        <TextBox x:Name="DnsFakeIpRangeBox" Width="140" PlaceholderText="198.18.0.1/16" />
                        <Button x:Uid="Common_Apply" Content="应用" Click="ApplyDns_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardController" Header="外部控制器" Description="RESTful API 地址与 Secret；应用后重启内核">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ControllerBox" Width="160" PlaceholderText="127.0.0.1:9097" />
                        <PasswordBox x:Name="ControllerSecretBox" Width="140" PlaceholderText="Secret" />
                        <Button x:Uid="Common_Apply" Content="应用" Click="ApplyController_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardAutoCloseConn" Header="断开连接于模式切换" Description="切换代理模式时关闭全部现有连接">
                    <ToggleSwitch x:Name="AutoCloseConnSwitch" Toggled="AutoCloseConn_Toggled" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock x:Uid="Settings_SectionApp" Text="应用" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard x:Uid="Settings_CardLanguage" Header="语言 / Language" Description="切换后需要重启应用生效">
                    <ComboBox x:Name="LanguageBox" Width="150" SelectionChanged="Language_Changed">
                        <ComboBoxItem x:Uid="Settings_ThemeSystem" Tag="system" Content="跟随系统" />
                        <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                        <ComboBoxItem Tag="en-US" Content="English" />
                        <ComboBoxItem Tag="zh-TW" Content="繁體中文" />
                        <ComboBoxItem Tag="ja" Content="日本語" />
                        <ComboBoxItem Tag="ko" Content="한국어" />
                        <ComboBoxItem Tag="de" Content="Deutsch" />
                        <ComboBoxItem Tag="es" Content="Español" />
                        <ComboBoxItem Tag="ru" Content="Русский" />
                        <ComboBoxItem Tag="tr" Content="Türkçe" />
                        <ComboBoxItem Tag="id" Content="Indonesia" />
                        <ComboBoxItem Tag="fa" Content="فارسی" />
                        <ComboBoxItem Tag="ar" Content="العربية" />
                        <ComboBoxItem Tag="tt" Content="Татарча" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardTheme" Header="主题模式">
                    <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="跟随系统" Tag="system" />
                        <ComboBoxItem x:Uid="Settings_ThemeLight" Content="浅色" Tag="light" />
                        <ComboBoxItem x:Uid="Settings_ThemeDark" Content="深色" Tag="dark" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardRestartCore" Header="重启内核" Description="重新加载运行时配置并重启 mihomo">
                    <Button x:Uid="Settings_RestartCoreButton2" Content="重启" Click="RestartCore_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardService" Header="Flux 服务" Description="以 LocalSystem 运行，普通用户无需管理员即可使用 TUN">
                    <Button x:Uid="Settings_InstallService" Content="安装 / 修复服务" Click="InstallService_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardLightweight" Header="轻量模式" Description="关闭窗口后释放主界面，仅保留托盘与内核">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="LightweightSwitch" Toggled="Lightweight_Toggled" />
                        <TextBox x:Uid="Settings_LightweightMinutes" x:Name="LightweightMinutesBox" Width="90" PlaceholderText="分钟" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardHotkeyWindow" Header="全局热键 · 显示 / 隐藏窗口" Description="如 Ctrl+Shift+F1；留空禁用">
                    <TextBox x:Name="HotkeyWindowBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardHotkeySysproxy" Header="全局热键 · 切换系统代理">
                    <TextBox x:Name="HotkeySysproxyBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardHotkeyTun" Header="全局热键 · 切换 TUN">
                    <TextBox x:Name="HotkeyTunBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardHotkeyReactivate" Header="全局热键 · 重新激活订阅">
                    <TextBox x:Name="HotkeyReactivateBox" MinWidth="180" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardHotkeySave" Header="全局热键" Description="保存时注册；冲突的组合会被拒绝并显示原因">
                    <Button x:Uid="Settings_SaveHotkeys" Content="保存热键" Click="SaveHotkeys_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardCopyEnv" Header="复制环境变量" Description="在终端中让命令行程序走代理">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="PowerShell" Click="CopyEnvPowerShell_Click" />
                        <Button Content="CMD" Click="CopyEnvCmd_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardLoopback" Header="UWP Loopback 工具" Description="允许 UWP 应用通过本机代理联网（需要管理员授权）">
                    <Button x:Uid="Settings_OpenLoopback" Content="打开工具" Click="OpenLoopback_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardBackup" Header="备份与恢复" Description="ZIP 备份应用配置、订阅与增强文件（不含日志与凭据明文）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_CreateBackup" Content="创建备份" Click="CreateBackup_Click" />
                        <Button x:Uid="Settings_RestoreBackup" Content="恢复备份" Click="RestoreBackup_Click" />
                        <Button x:Uid="Settings_BackupDir" Content="备份目录" Click="OpenBackupDir_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardWebDav" Header="WebDAV 备份" Description="云端备份；密码经 DPAPI 加密存储，界面不回显">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_WebDavConfig" Content="设置服务器" Click="WebDavConfig_Click" />
                        <Button x:Uid="Settings_WebDavUpload" Content="上传" Click="WebDavUpload_Click" />
                        <Button x:Uid="Settings_WebDavRestore" Content="恢复" Click="WebDavRestore_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="诊断与更新" Description="导出本地诊断包；检查 GitHub 最新版本">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_ExportDiagnostics" Content="导出诊断包" Click="ExportDiagnostics_Click" />
                        <Button x:Uid="Settings_CheckUpdate" Content="检查更新" Click="CheckUpdate_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardOpenDirs" Header="打开目录" Description="数据目录 / 日志目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_OpenData" Content="数据目录" Click="OpenData_Click" />
                        <Button x:Uid="Settings_OpenLogs" Content="日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="GitHub" Description="查看 Flux 的源代码和最新动态">
                    <Button x:Uid="Settings_OpenGitHub" Content="打开 GitHub" Click="OpenGitHub_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard x:Uid="Settings_CardAbout" Header="关于 Flux" Description="{x:Bind AppVersion, Mode=OneTime}">
                    <Button x:Uid="Settings_ExitApp" Content="退出应用" Click="ExitApp_Click" />
                </sc:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

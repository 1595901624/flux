<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,16,28,20"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <TextBlock Text="系统设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="开机自启动" Description="登录 Windows 时自动启动 Flux">
                    <ToggleSwitch x:Name="AutoLaunchSwitch" Toggled="AutoLaunch_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="静默启动" Description="启动时不显示主窗口">
                    <ToggleSwitch x:Name="SilentStartSwitch" Toggled="SilentStart_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="系统代理" Description="将 Flux 设为系统 HTTP/HTTPS 代理">
                    <ToggleSwitch x:Name="SysProxySwitch" Toggled="SysProxy_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="代理守护" Description="定期检查并恢复被其他程序修改的系统代理">
                    <ToggleSwitch x:Name="ProxyGuardSwitch" Toggled="ProxyGuard_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="代理绕过列表" Description="不经过代理的地址（分号分隔）">
                    <TextBox x:Name="BypassBox" MinWidth="260" MaxWidth="520" HorizontalAlignment="Right"
                             LostFocus="Bypass_LostFocus" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock Text="Clash 设置" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="混合代理端口" Description="HTTP/SOCKS5 混合监听端口（1024-65535）">
                    <NumberBox x:Name="MixedPortBox" Width="140" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden"
                               ValueChanged="MixedPort_Changed" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="允许局域网连接" Description="允许局域网内其他设备使用本机代理">
                    <ToggleSwitch x:Name="AllowLanSwitch" Toggled="AllowLan_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="IPv6" Description="启用 IPv6 支持">
                    <ToggleSwitch x:Name="Ipv6Switch" Toggled="Ipv6_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="日志级别">
                    <ComboBox x:Name="LogLevelBox" Width="140" SelectionChanged="LogLevel_Changed">
                        <ComboBoxItem Content="debug" Tag="debug" />
                        <ComboBoxItem Content="info" Tag="info" />
                        <ComboBoxItem Content="warning" Tag="warning" />
                        <ComboBoxItem Content="error" Tag="error" />
                        <ComboBoxItem Content="silent" Tag="silent" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard Header="应用日志" Description="将运行日志写入日志目录（默认关闭）">
                    <ToggleSwitch x:Name="EnableLogSwitch" Toggled="EnableLog_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="TUN 模式" Description="接管全部系统流量（需要管理员权限）">
                    <ToggleSwitch x:Name="TunSwitch" Toggled="Tun_Toggled" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="断开连接于模式切换" Description="切换代理模式时关闭全部现有连接">
                    <ToggleSwitch x:Name="AutoCloseConnSwitch" Toggled="AutoCloseConn_Toggled" />
                </sc:SettingsCard>
            </StackPanel>

            <TextBlock Text="应用" FontSize="16" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
            <StackPanel Spacing="2" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <sc:SettingsCard Header="主题模式">
                    <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="跟随系统" Tag="system" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                </sc:SettingsCard>
                <sc:SettingsCard Header="重启内核" Description="重新加载运行时配置并重启 mihomo">
                    <Button Content="重启" Click="RestartCore_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="打开目录" Description="数据目录 / 日志目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="数据目录" Click="OpenData_Click" />
                        <Button Content="日志目录" Click="OpenLogs_Click" />
                    </StackPanel>
                </sc:SettingsCard>
                <sc:SettingsCard Header="GitHub" Description="查看 Flux 的源代码和最新动态">
                    <Button Content="打开 GitHub" Click="OpenGitHub_Click" />
                </sc:SettingsCard>
                <sc:SettingsCard Header="关于 Flux" Description="{x:Bind AppVersion, Mode=OneTime}">
                    <Button Content="退出应用" Click="ExitApp_Click" />
                </sc:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

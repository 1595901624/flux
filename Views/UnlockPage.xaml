<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flux.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Flux.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Unlock_Title" Text="解锁测试" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Uid="Unlock_Subtitle" Grid.Column="1" Text="检测当前节点对流媒体与 AI 服务的解锁状态（请求经内核代理）"
                       FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Uid="Unlock_RunAll" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                    Click="RunAll_Click" x:Name="RunAllButton">
                全部测试
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="StatusPanel" Visibility="Collapsed" Spacing="8">
            <ProgressBar x:Name="RunProgress" IsIndeterminate="True" />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="ResultList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UnlockItemVm">
                    <Grid Padding="12,6,12,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{x:Bind StatusBrush}" CornerRadius="4"
                                Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="White" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsTextSelectionEnabled="True" />
                        <Button x:Uid="Unlock_Retest" Grid.Column="3" Content="重测" Style="{StaticResource SubtleButtonStyle}"
                                FontSize="11" Click="Retest_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

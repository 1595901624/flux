<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Flux.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（Mica 背景） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image Width="22" Height="22" Source="ms-appx:///Assets/app.svg" AutomationProperties.Name="Flux" />
                <TextBlock Text="Flux" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="AppTitleSub" Text="" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="首页">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="proxies" Content="代理">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8CB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="profiles" Content="订阅">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="connections" Content="连接">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="rules" Content="规则">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="logs" Content="日志">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="settings" Content="设置">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid x:Name="TrafficFooter" Height="88" Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpText" Text="↑ —" FontSize="11" Opacity="0.8" FontFamily="Consolas" />
                        <TextBlock x:Name="DownText" Text="↓ —" Grid.Column="1" HorizontalAlignment="Right" FontSize="11" Opacity="0.8" FontFamily="Consolas" />
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}" Padding="2">
                        <Grid x:Name="GraphHost">
                            <Polygon x:Name="DownPolygon" Fill="#55E06C75" />
                            <Polyline x:Name="DownLine" Stroke="#E06C75" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Polygon x:Name="UpPolygon" Fill="#5558A6FF" />
                            <Polyline x:Name="UpLine" Stroke="#58A6FF" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Flux.Service</RootNamespace>
    <AssemblyName>Flux.Service</AssemblyName>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <Version>0.3.0</Version>
    <Description>Flux 特权服务：以 LocalSystem 运行，仅负责 mihomo 的特权生命周期管理。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flux.Core\Flux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\core\win-x86\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-x86'" />
    <Content Include="..\Assets\core\win-x64\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <Content Include="..\Assets\core\win-arm64\mihomo.exe" Link="core\mihomo.exe" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>

</Project>

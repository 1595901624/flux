<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vxn.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Vxn.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="日志" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="LevelBox" Grid.Column="1" VerticalAlignment="Center" Width="120"
                      SelectionChanged="LevelBox_SelectionChanged" SelectedIndex="1">
                <ComboBoxItem Tag="all" Content="全部级别" />
                <ComboBoxItem Tag="info" Content="Info 及以上" />
                <ComboBoxItem Tag="warning" Content="Warning 及以上" />
                <ComboBoxItem Tag="error" Content="Error" />
                <ComboBoxItem Tag="debug" Content="Debug" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="240" VerticalAlignment="Center"
                     PlaceholderText="搜索日志内容" TextChanged="SearchBox_TextChanged" />
            <Button x:Name="PauseButton" Grid.Column="3" VerticalAlignment="Center" Click="Pause_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                    <TextBlock Text="暂停" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" VerticalAlignment="Center" Click="Clear_Click" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
            <TextBlock Text="{x:Bind Vm.CountText, Mode=OneWay}" Grid.Column="5" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" x:Name="EmptyPanel" Visibility="Visible" Spacing="6" HorizontalAlignment="Center" Margin="0,40,0,0">
            <FontIcon Glyph="&#xE9D9;" FontSize="32" Opacity="0.35" />
            <TextBlock Text="暂无日志" Opacity="0.55" HorizontalAlignment="Center" />
        </StackPanel>

        <ListView
            x:Name="LogList"
            Grid.Row="2"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogItemVm">
                    <Grid Padding="12,3,12,3" ColumnSpacing="10" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" FontFamily="Consolas" />
                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TypeText}" FontSize="10" Foreground="{x:Bind TypeBrush}" FontFamily="Consolas" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{x:Bind Payload}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontFamily="Consolas" IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
